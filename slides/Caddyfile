:80 {
    root * /srv
    
    # Enable compression (Cloudflare will also compress, but this helps origin)
    encode gzip zstd
    
    # SPA fallback - try files, then fall back to index.html
    try_files {path} /index.html
    
    file_server {
        precompressed gzip
    }
    
    # === CDN-OPTIMIZED CACHE HEADERS ===
    
    # Immutable assets (hashed filenames) - cache forever
    @immutable {
        path_regexp immutable \.(js|css|woff2?|png|jpe?g|gif|svg|ico|webp|avif)$
        not path /index.html
    }
    header @immutable {
        Cache-Control "public, max-age=31536000, immutable"
        # Tell Cloudflare to cache aggressively
        CDN-Cache-Control "public, max-age=31536000"
    }
    
    # HTML pages - short cache, revalidate
    @html {
        path *.html /
    }
    header @html {
        Cache-Control "public, max-age=60, must-revalidate"
        CDN-Cache-Control "public, max-age=300"
    }
    
    # JSON/data files - moderate cache
    @data {
        path *.json
    }
    header @data {
        Cache-Control "public, max-age=300, must-revalidate"
    }
}
